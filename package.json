{
  "name": "@sourceloop/mastra-loopback",
  "version": "0.1.0",
  "description": "SourceLoop community LoopBack 4 server adapter for Mastra",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "build": "tsdown --silent --config tsdown.config.ts",
    "build:watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run src/loopback-mastra-server.test.ts",
    "test:integration": "vitest run src/__tests__/integration",
    "test:conformance": "vitest run src/__tests__/conformance",
    "verify": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.2",
    "@mastra/server": "^1.72.0"
  },
  "peerDependencies": {
    "@loopback/core": "^7.0.15",
    "@loopback/rest": "^15.0.16",
    "@mastra/core": ">=1.72.0 <2.0.0-0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@loopback/core": "^7.0.15",
    "@loopback/rest": "^15.0.16",
    "@mastra/core": "^1.72.0",
    "@mastra/mcp": "^2.0.0",
    "@mastra/server-adapters-test-suite": "^0.1.1",
    "@types/node": "^22.20.4",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "mastra",
    "loopback",
    "loopback4",
    "server-adapter",
    "mcp",
    "ai-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samarpanB/mastra-loopback4.git"
  },
  "bugs": {
    "url": "https://github.com/samarpanB/mastra-loopback4/issues"
  },
  "homepage": "https://github.com/samarpanB/mastra-loopback4#readme",
  "publishConfig": {
    "access": "public"
  }
}
