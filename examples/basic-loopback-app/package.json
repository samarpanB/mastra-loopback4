{
  "name": "basic-loopback-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix ../.. run build",
    "typecheck": "tsc --noEmit",
    "dev": "npm --prefix ../.. run build && tsx src/index.ts",
    "dev:agent-example": "npm --prefix ../.. run build && tsx src/repository-tool-agent-route-example.ts",
    "dev:sourcefuse-auth-example": "npm --prefix ../.. run build && tsx src/sourcefuse-auth-jwt-example.ts"
  },
  "dependencies": {
    "@loopback/core": "^7.0.15",
    "@loopback/repository": "^8.0.15",
    "@loopback/rest": "^15.0.16",
    "@mastra/core": "^1.72.0",
    "@sourceloop/mastra-loopback": "file:../..",
    "jsonwebtoken": "^9.0.3",
    "loopback4-authentication": "^14.0.1",
    "loopback4-authorization": "^9.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
